# Application
NODE_ENV=development
PORT=3000
# Browser origins only, comma-separated, no trailing slash. Empty disables CORS.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Required: generate your own value and replace this rejected placeholder.
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# The application and Prisma read this value only from .env.
DATABASE_URL=postgresql://partymaker:change_me_local@localhost:55432/partymaker?schema=public

# Used by docker-compose.yml to create the local PostgreSQL container.
POSTGRES_USER=partymaker
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=partymaker
POSTGRES_PORT=55432
